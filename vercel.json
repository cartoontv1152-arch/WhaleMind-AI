{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npx --yes pnpm@10.24.0 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@10.24.0 build",
  "regions": ["hkg1"],
  "headers": [
    {
      "source": "/api/health",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
